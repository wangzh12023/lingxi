[
  {"id": "f091", "text": "之前一直在北京的百货专柜买，柜姐人很好，每次都送一堆小样，后来搬到成都就改在网上买了，最近才发现线上线下好像不是一个账户，以前攒的积分这边都看不到，能帮我并过来吗", "intents": ["membership"], "emotions": ["calm"], "risks": [], "kind": "late_cue"},
  {"id": "f092", "text": "绝了，昨天下单今天就到", "intents": ["other"], "emotions": ["joy"], "risks": [], "kind": "colloquial"},
  {"id": "f093", "text": "全网都在说你们偷偷换了配方，你们还打算装到什么时候", "intents": ["authenticity"], "emotions": ["anger"], "risks": ["pr"], "kind": "plain"},
  {"id": "f094", "text": "也不是差这点钱，就是心里不舒服，昨天刚买今天就降了八十", "intents": ["price_promo"], "emotions": ["grievance"], "risks": [], "kind": "negation"},
  {"id": "f095", "text": "算了，不用帮我查了，反正也查不出个所以然", "intents": ["complaint"], "emotions": ["sadness"], "risks": ["churn"], "kind": "implicit"},
  {"id": "f096", "text": "谢谢上次推荐的身体乳，真挺好用的，想问下脸上也能擦吗", "intents": ["usage_guidance"], "emotions": ["gratitude"], "risks": [], "kind": "plain"},
  {"id": "f097", "text": "我老公是律师，常年出差，想送他一套方便带的男士护肤", "intents": ["gift_consult"], "emotions": ["calm"], "risks": [], "kind": "decoy"},
  {"id": "f098", "text": "明明还在七天无理由期限内，凭什么不给退？我已经打了12315", "intents": ["return_refund", "complaint"], "emotions": ["grievance", "anger"], "risks": ["legal"], "kind": "plain"},
  {"id": "f099", "text": "这款防晒有小样卖吗？另外现在下单有满减不", "intents": ["pre_sale_consult", "price_promo"], "emotions": ["calm"], "risks": [], "kind": "multi"},
  {"id": "f100", "text": "我下周三的飞机，东西到现在还没影儿呢", "intents": ["logistics"], "emotions": ["anxiety"], "risks": [], "kind": "implicit"},
  {"id": "f101", "text": "佩服佩服，同一个问题我说了五遍，换了四个客服，每个都让我从头讲一遍，这精神损失费你们打算怎么算", "intents": ["complaint"], "emotions": ["grievance", "anger"], "risks": ["fraud"], "kind": "sarcasm"},
  {"id": "f102", "text": "我15岁，能用你们的粉底液吗，想学化妆", "intents": ["skin_matching"], "emotions": ["anticipation"], "risks": ["minor"], "kind": "plain"},
  {"id": "f103", "text": "我平时不太爱找客服，这次也不是想退货或者找你们麻烦，就是这支睫毛膏刷了两天以后，眼睛一直流眼泪，眼皮也肿起来了，想问问该怎么办", "intents": ["adverse_reaction"], "emotions": ["anxiety"], "risks": ["safety"], "kind": "negation"},
  {"id": "f104", "text": "下单忘用券了 还能补救不", "intents": ["price_promo"], "emotions": ["calm"], "risks": [], "kind": "colloquial"},
  {"id": "f105", "text": "我身份证号是320583199604115273，你们帮我核实下实名信息", "intents": ["other"], "emotions": ["calm"], "risks": ["privacy"], "kind": "plain"},
  {"id": "f106", "text": "五月份我妈过生日，她最近老念叨脸干", "intents": ["gift_consult"], "emotions": ["calm"], "risks": [], "kind": "implicit"},
  {"id": "f107", "text": "上次那事其实已经处理完了，我也不是要发微博或者找谁曝光你们，就是觉得退货流程绕来绕去太费劲，填个单子要跳三个页面，想给你们提个建议", "intents": ["complaint"], "emotions": ["calm"], "risks": [], "kind": "decoy"},
  {"id": "f108", "text": "等了一个月的预售礼盒，今天通知我没货要退款，白高兴一场，算了，你们家我以后不来了", "intents": ["return_refund"], "emotions": ["sadness"], "risks": ["churn"], "kind": "plain"},
  {"id": "f109", "text": "黑卡会员哦，等级这么高，兑个小样要排队三个月，可真有面子", "intents": ["membership"], "emotions": ["grievance", "anger"], "risks": [], "kind": "sarcasm"},
  {"id": "f110", "text": "最近在研究成分，看了你们家好几款精华和面霜，评价都还不错，价格也都能接受，就是我上个月刚做完激光祛斑，脸还在恢复期，不知道这段时间能不能用", "intents": ["skin_matching"], "emotions": ["calm"], "risks": [], "kind": "late_cue"},
  {"id": "f111", "text": "嗯嗯 懂了 谢谢亲～", "intents": ["other"], "emotions": ["gratitude"], "risks": [], "kind": "colloquial"},
  {"id": "f112", "text": "我怀疑是快递员调了包，你把那个快递员的电话和家庭住址发我，我自己去找他", "intents": ["authenticity", "logistics"], "emotions": ["anger"], "risks": ["privacy"], "kind": "plain"},
  {"id": "f113", "text": "拆开试了一下，跟想的不太一样，盒子还留着", "intents": ["return_refund"], "emotions": ["calm"], "risks": [], "kind": "implicit"},
  {"id": "f114", "text": "我没兑换过任何东西，积分怎么就从三千多变成八百了", "intents": ["membership"], "emotions": ["anxiety"], "risks": [], "kind": "negation"},
  {"id": "f115", "text": "页面上写七天淡斑，我用了一个月啥变化没有，截图都留好了，准备去市场监管局举报你们虚假宣传", "intents": ["complaint", "product_efficacy"], "emotions": ["anger"], "risks": ["legal"], "kind": "plain"},
  {"id": "f116", "text": "520想给对象整个惊喜 预算一千以内 求推荐", "intents": ["gift_consult"], "emotions": ["anticipation"], "risks": [], "kind": "colloquial"},
  {"id": "f117", "text": "订单里写着送一支唇釉，盒子里翻遍了也没有", "intents": ["price_promo"], "emotions": ["calm"], "risks": [], "kind": "implicit"},
  {"id": "f118", "text": "刚才跟我吵的那个客服叫什么名字，把她工号和手机号发我", "intents": ["complaint"], "emotions": ["anger"], "risks": ["privacy"], "kind": "plain"},
  {"id": "f119", "text": "退款收到了，谢谢！顺便问下之前那单的积分会被扣回去吗", "intents": ["membership", "other"], "emotions": ["gratitude"], "risks": [], "kind": "multi"},
  {"id": "f120", "text": "太好了，补发的赠品收到了，还以为没戏了，谢谢", "intents": ["other"], "emotions": ["gratitude", "joy"], "risks": [], "kind": "plain"}
]
