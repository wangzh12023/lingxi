[
  {"id": "f001", "text": "想入个眼霜，紫色那支跟白色那支有啥区别鸭", "intents": ["pre_sale_consult"], "emotions": ["anticipation"], "risks": [], "kind": "colloquial"},
  {"id": "f002", "text": "用你们家精华烂脸了，照片我都拍好了，准备发小红书让大家避雷", "intents": ["adverse_reaction"], "emotions": ["anger"], "risks": ["safety", "pr"], "kind": "plain"},
  {"id": "f003", "text": "下单五天了，物流那一栏还是空的", "intents": ["logistics"], "emotions": ["anxiety"], "risks": [], "kind": "implicit"},
  {"id": "f004", "text": "我妈用这个烂过脸，我都不太敢买了，油痘肌能用吗", "intents": ["skin_matching"], "emotions": ["anxiety"], "risks": [], "kind": "negation"},
  {"id": "f005", "text": "号称28天焕新，我这第二瓶都见底了，焕了个寂寞", "intents": ["product_efficacy", "complaint"], "emotions": ["anger"], "risks": [], "kind": "sarcasm"},
  {"id": "f006", "text": "好的，收到，谢谢你这么耐心", "intents": ["other"], "emotions": ["gratitude"], "risks": [], "kind": "plain"},
  {"id": "f007", "text": "我在消协上班，天天对着电脑，脸黄得不行，有啥提亮的妆前乳推荐吗", "intents": ["pre_sale_consult"], "emotions": ["calm"], "risks": [], "kind": "decoy"},
  {"id": "f008", "text": "退了吧，以后也不会再买你们家的东西了", "intents": ["return_refund"], "emotions": ["sadness"], "risks": ["churn"], "kind": "plain"},
  {"id": "f009", "text": "上个月在你们直播间买的那套礼盒，本来是打算送我妈当生日礼物的，生日就是这周六，今天看了一眼物流，还停在广州分拨中心，好几天没更新了", "intents": ["logistics"], "emotions": ["anxiety"], "risks": [], "kind": "late_cue"},
  {"id": "f010", "text": "积分能抵现不 还是只能换小样啊", "intents": ["membership"], "emotions": ["calm"], "risks": [], "kind": "colloquial"},
  {"id": "f011", "text": "收到的精华外盒塑封是破的，瓶口还有点脏，这是被人用过的吧？按规矩得退一赔三", "intents": ["authenticity"], "emotions": ["anger"], "risks": ["fraud"], "kind": "plain"},
  {"id": "f012", "text": "行吧，就这样吧，我以后知道该去哪儿买了", "intents": ["complaint"], "emotions": ["sadness"], "risks": ["churn"], "kind": "implicit"},
  {"id": "f013", "text": "维C精华跟A醇能一起用吗？我混油皮，两个里哪个更适合我", "intents": ["usage_guidance", "skin_matching"], "emotions": ["calm"], "risks": [], "kind": "multi"},
  {"id": "f014", "text": "孕晚期了，那个含视黄醇的晚霜还能接着用吗，有点担心", "intents": ["skin_matching"], "emotions": ["anxiety"], "risks": [], "kind": "plain"},
  {"id": "f015", "text": "厉害了，上海到杭州走了一个礼拜，骑自行车都到了", "intents": ["logistics"], "emotions": ["anger"], "risks": [], "kind": "sarcasm"},
  {"id": "f016", "text": "公司年会抽奖要备二十份，每份三百左右，男女都有", "intents": ["gift_consult"], "emotions": ["calm"], "risks": [], "kind": "implicit"},
  {"id": "f017", "text": "涂完这个唇膏嘴巴麻麻的 还起了一圈小泡泡 这正常吗", "intents": ["adverse_reaction"], "emotions": ["anxiety"], "risks": ["safety"], "kind": "colloquial"},
  {"id": "f018", "text": "我刚上高一，零花钱不多，有没有一百块以内的洗面奶", "intents": ["pre_sale_consult"], "emotions": ["calm"], "risks": ["minor"], "kind": "plain"},
  {"id": "f019", "text": "救救孩子，粉底卡粉卡到怀疑人生，是不是上妆前得先多拍点水", "intents": ["usage_guidance"], "emotions": ["anxiety"], "risks": [], "kind": "decoy"},
  {"id": "f020", "text": "已经在黑猫投诉发帖了，你们自己看着办", "intents": ["complaint"], "emotions": ["anger"], "risks": ["pr"], "kind": "plain"},
  {"id": "f021", "text": "不是质量问题哈，就是囤多了，没拆封的能退两瓶吗", "intents": ["return_refund"], "emotions": ["calm"], "risks": [], "kind": "negation"},
  {"id": "f022", "text": "拆开一看瓶底印的是2023年，我这是买到压箱底的货了吧", "intents": ["authenticity"], "emotions": ["anxiety"], "risks": [], "kind": "implicit"},
  {"id": "f023", "text": "我老婆也是你们家会员，把她的手机号和最近买了啥都发我看看", "intents": ["membership"], "emotions": ["calm"], "risks": ["privacy"], "kind": "plain"},
  {"id": "f024", "text": "夏天我T区出油能煎蛋，那个控油乳液能顶几个钟", "intents": ["product_efficacy"], "emotions": ["calm"], "risks": [], "kind": "colloquial"},
  {"id": "f025", "text": "这款面霜是看闺蜜用着不错我才下单的，包装挺好看，味道我也喜欢，头两天都好好的，昨晚涂完半边脸开始刺痛，今天早上起来眼睛周围全肿了", "intents": ["adverse_reaction"], "emotions": ["anxiety"], "risks": ["safety"], "kind": "late_cue"},
  {"id": "f026", "text": "给我侄女挑个生日礼物，她今年16，想要支口红，哪个色号适合学生", "intents": ["gift_consult"], "emotions": ["anticipation"], "risks": ["minor"], "kind": "plain"},
  {"id": "f027", "text": "我认识好几个美妆博主，要不要让她们帮你们宣传宣传这售后啊", "intents": ["complaint"], "emotions": ["anger"], "risks": ["pr"], "kind": "sarcasm"},
  {"id": "f028", "text": "用完这瓶我以后不会再买别家的了，太好用了", "intents": ["other"], "emotions": ["joy"], "risks": [], "kind": "decoy"},
  {"id": "f029", "text": "这色号上脸黑了两个度 能退不", "intents": ["return_refund"], "emotions": ["calm"], "risks": [], "kind": "colloquial"},
  {"id": "f030", "text": "再不给我发货我就去微博挂你们，说到做到", "intents": ["logistics", "complaint"], "emotions": ["anger"], "risks": ["pr"], "kind": "plain"}
]
