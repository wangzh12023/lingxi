[
  {"id": "f031", "text": "这款面膜我回购好几次了，一直挺喜欢的，这次活动一口气囤了六盒，结果刚好赶上搬家，东西太多放不下，想问问没拆的那四盒能不能退掉", "intents": ["return_refund"], "emotions": ["calm"], "risks": [], "kind": "late_cue"},
  {"id": "f032", "text": "终于补货了！！限购几支啊 我想给闺蜜也带一支", "intents": ["pre_sale_consult"], "emotions": ["joy"], "risks": [], "kind": "colloquial"},
  {"id": "f033", "text": "不是我用的，是我闺女，才十二，偷用了我的去角质，现在脸上一块一块地红", "intents": ["adverse_reaction"], "emotions": ["anxiety"], "risks": ["safety", "minor"], "kind": "negation"},
  {"id": "f034", "text": "我朋友比我晚一天下单，一样的东西比我少付了一百多", "intents": ["price_promo"], "emotions": ["grievance"], "risks": [], "kind": "implicit"},
  {"id": "f035", "text": "专柜的人看了说我这瓶是假的，旗舰店也卖假货？假一赔十，没得商量", "intents": ["authenticity"], "emotions": ["anger"], "risks": ["fraud"], "kind": "plain"},
  {"id": "f036", "text": "看好多博主都说这个水乳能祛痘，靠谱吗", "intents": ["product_efficacy"], "emotions": ["calm"], "risks": [], "kind": "decoy"},
  {"id": "f037", "text": "用了一个月痘印真淡了好多！这个能一直用下去吗，要不要隔一阵停停", "intents": ["usage_guidance"], "emotions": ["joy"], "risks": [], "kind": "plain"},
  {"id": "f038", "text": "你们这客服是机器人吧 车轱辘话来回说 不聊了 拜拜", "intents": ["complaint"], "emotions": ["anger"], "risks": ["churn"], "kind": "colloquial"},
  {"id": "f039", "text": "我这脸一碰酒精就红，你们这个水里有那玩意儿没", "intents": ["skin_matching"], "emotions": ["calm"], "risks": [], "kind": "implicit"},
  {"id": "f040", "text": "旗舰店卖的东西批号都查不到，你们可真够官方的", "intents": ["authenticity"], "emotions": ["anger"], "risks": [], "kind": "sarcasm"},
  {"id": "f041", "text": "发票能开公司抬头吗？需要专票", "intents": ["other"], "emotions": ["calm"], "risks": [], "kind": "plain"},
  {"id": "f042", "text": "我没签收啊，物流怎么就显示已签收了，门口也没有", "intents": ["logistics"], "emotions": ["anxiety"], "risks": [], "kind": "negation"},
  {"id": "f043", "text": "积分快过期了也懒得换了，反正以后也不打算在你们家买了", "intents": ["membership"], "emotions": ["sadness"], "risks": ["churn"], "kind": "plain"},
  {"id": "f044", "text": "想送闺蜜一套彩妆，能包成礼盒吗？大概几天能到", "intents": ["gift_consult", "logistics"], "emotions": ["anticipation"], "risks": [], "kind": "multi"},
  {"id": "f045", "text": "寄回去的那箱你们都签收一个礼拜了，我这边还是一分钱没见着", "intents": ["return_refund"], "emotions": ["anxiety", "grievance"], "risks": [], "kind": "implicit"},
  {"id": "f046", "text": "用了两周痘印一点没淡，这精华是不是对我没用啊", "intents": ["product_efficacy"], "emotions": ["sadness"], "risks": [], "kind": "plain"},
  {"id": "f047", "text": "染发膏那个双氧乳是全挤进去还是挤一半啊 怕翻车", "intents": ["usage_guidance"], "emotions": ["anxiety"], "risks": [], "kind": "colloquial"},
  {"id": "f048", "text": "第一次打电话说三天内给答复，第二次说已经加急了，第三次又让我重新提交材料，我一个上班族为这事请了两次假，现在只想找个能做主的人", "intents": ["complaint"], "emotions": ["grievance"], "risks": [], "kind": "late_cue"},
  {"id": "f049", "text": "哺乳期能涂口红吗？宝宝老爱往我脸上蹭", "intents": ["skin_matching"], "emotions": ["calm"], "risks": [], "kind": "decoy"},
  {"id": "f050", "text": "染发膏把我头皮弄得全是水泡，医药费加精神损失费，少于两万免谈", "intents": ["adverse_reaction"], "emotions": ["anger"], "risks": ["safety", "fraud"], "kind": "plain"},
  {"id": "f051", "text": "下个月去三亚，我这种一晒就黑的得备点啥", "intents": ["pre_sale_consult"], "emotions": ["anticipation"], "risks": [], "kind": "implicit"},
  {"id": "f052", "text": "跟你们说了半个月一点用没有，我只能去找消协了", "intents": ["complaint"], "emotions": ["grievance"], "risks": ["legal"], "kind": "plain"},
  {"id": "f053", "text": "真是好东西啊，用完我脸红得跟猴屁股一样，谢谢你们了啊", "intents": ["adverse_reaction"], "emotions": ["anger"], "risks": ["safety"], "kind": "sarcasm"},
  {"id": "f054", "text": "不是想退货哈，就想知道这个眼霜对黑眼圈到底有没有用", "intents": ["product_efficacy"], "emotions": ["calm"], "risks": [], "kind": "negation"},
  {"id": "f055", "text": "说好的买一送一只发了一个，要么补发，要么按三倍价格赔我", "intents": ["price_promo"], "emotions": ["anger"], "risks": ["fraud"], "kind": "plain"},
  {"id": "f056", "text": "亲 我那单啥时候能到呀 等着用呢", "intents": ["logistics"], "emotions": ["anxiety"], "risks": [], "kind": "colloquial"},
  {"id": "f057", "text": "盒子上一个中文都没有，是不是水货？是的话我直接退了", "intents": ["authenticity", "return_refund"], "emotions": ["anxiety"], "risks": [], "kind": "multi"},
  {"id": "f058", "text": "我女儿14岁，额头长了好多痘，能用你们那款祛痘洁面吗", "intents": ["skin_matching"], "emotions": ["calm"], "risks": ["minor"], "kind": "plain"},
  {"id": "f059", "text": "问题解决了，比我想的快多了", "intents": ["other"], "emotions": ["joy"], "risks": [], "kind": "implicit"},
  {"id": "f060", "text": "退款申请被驳回第四次了，每次理由都不一样，再这样我就去法院起诉", "intents": ["return_refund", "complaint"], "emotions": ["grievance", "anger"], "risks": ["legal"], "kind": "plain"}
]
