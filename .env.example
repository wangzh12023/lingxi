# 复制为 .env.local 后填写，然后重启服务。不填任何内容也能运行（离线模式）。
#
# 默认使用阿里云百炼兼容接口，也可换成其他 OpenAI 兼容服务。
# 已通过兼容接口验证关键模型调用；首次配置自己的服务时，请到「模型与设置」页点“测试连接”。

# 百炼「华北2·北京」地域、按量付费的 API Key（sk- 开头）。Key 按地域绑定，用错地域会返回 401。
LLM_API_KEY=

# OpenAI 兼容模式。这个域名北京地域的 Key 都能用，不需要业务空间 ID。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 官方现在推荐业务空间专属域名（把 llm-xxx 换成创建 Key 时显示的业务空间 ID）：
# LLM_BASE_URL=https://llm-xxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 主模型：千问 3.8 开源 27B（Apache-2.0），可读图，支持 JSON 输出和前缀缓存。
LLM_MODEL=qwen3.8-27b
# 快速模型：低风险咨询只用它起草。千问 3.5 开源 35B-A3B，百炼在售开源权重里最便宜的一档。
LLM_FAST_MODEL=qwen3.5-35b-a3b
# 图片识别：与主模型相同。（旧的 qwen-vl-plus 已于 2026-10-10 下线）
LLM_VISION_MODEL=qwen3.8-27b

# 千问 3.5 以后的模型默认开启思考。灵犀对 aliyuncs.com 的调用默认关闭它；
# 接其他服务商时默认不发送这个参数。可以用 1 / 0 强制指定。
# LLM_DISABLE_THINKING=1

# 单次调用超时（毫秒）
LLM_TIMEOUT_MS=45000

# 设为 offline 可在配置了密钥的情况下强制离线，便于对比两种模式
# LINGXI_MODE=offline
